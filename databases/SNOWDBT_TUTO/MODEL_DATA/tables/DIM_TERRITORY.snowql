
-- SNOWDBT_TUTO.MODEL_DATA.DIM_TERRITORY definition

create or replace TABLE SNOWDBT_TUTO.MODEL_DATA.DIM_TERRITORY (
	TERRITORY_KEY VARCHAR(32),
	TERRITORYID NUMBER(2,0),
	SALESTERRITORYNAME VARCHAR(60),
	TERRITORY_GROUP VARCHAR(16777216),
	COUNTRYREGIONCODE VARCHAR(16777216),
	COSTYTD NUMBER(5,4),
	SALESYTD NUMBER(12,4),
	COSTLASTYEAR NUMBER(5,4),
	SALESLASTYEAR NUMBER(11,4),
	MODIFIEDDATE TIMESTAMP_NTZ(9),
	CONSTRAINT PK_DIM_TERRITORY PRIMARY KEY (TERRITORY_KEY)
);