
-- SNOWDBT_TUTO.MODEL_DATA.DIM_PRODUCT definition

create or replace TABLE SNOWDBT_TUTO.MODEL_DATA.DIM_PRODUCT (
	PRODUCT_KEY VARCHAR(32),
	PRODUCTID NUMBER(3,0),
	PRODUCT_NAME VARCHAR(60),
	PRODUCTNUMBER VARCHAR(16777216),
	COLOR VARCHAR(16777216),
	DAYSTOMANUFACTURE NUMBER(1,0),
	SAFETYSTOCKLEVEL NUMBER(4,0),
	STANDARDCOST NUMBER(8,4),
	PRODUCT_SUBCATEGORY_NAME VARCHAR(50),
	PRODUCT_CATEGORY_NAME VARCHAR(50),
	SELLSTARTDATE TIMESTAMP_NTZ(9),
	SELLENDDATE TIMESTAMP_NTZ(9),
	CONSTRAINT PK_DIM_PRODUCT PRIMARY KEY (PRODUCT_KEY)
);