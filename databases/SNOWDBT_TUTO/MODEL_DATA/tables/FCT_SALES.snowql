
-- SNOWDBT_TUTO.MODEL_DATA.FCT_SALES definition

create or alter TABLE SNOWDBT_TUTO.MODEL_DATA.FCT_SALES (
	SALES_KEY VARCHAR(32),
	PRODUCT_KEY VARCHAR(32),
	CUSTOMER_KEY VARCHAR(32),
	CREDITCARD_KEY VARCHAR(32),
	SHIP_ADDRESS_KEY VARCHAR(32),
	ORDER_STATUS_KEY VARCHAR(32),
	ORDER_DATE_KEY VARCHAR(32),
	SHIP_DATE_KEY VARCHAR(32),
	DUE_DATE_KEY VARCHAR(32),
	TERRITORY_KEY VARCHAR(32),
	ORDERDATE TIMESTAMP_NTZ(9),
	ONLINEORDERFLAG VARCHAR(1),
	UNITPRICEDISCOUNT NUMBER(5,4),
	SALESORDERNUMBER VARCHAR(16777216),
	SALESORDERID NUMBER(5,0),
	SALESORDERDETAILID NUMBER(6,0),
	UNITPRICE NUMBER(8,4),
	ORDERQTY NUMBER(2,0),
	REVENUE NUMBER(11,6),
	SALESAMOUNT NUMBER(11,6),
	TOTALDISCOUNT NUMBER(16,10),
	TAXAMT NUMBER(9,4),
	CONSTRAINT PK_FCT_SALES PRIMARY KEY (SALES_KEY),
	CONSTRAINT FK_FCT_SALES_DIM_CUSTOMER FOREIGN KEY (CUSTOMER_KEY) REFERENCES SNOWDBT_TUTO.MODEL_DATA.DIM_CUSTOMER(CUSTOMER_KEY),
	CONSTRAINT FK_FCT_SALES_DIM_PRODUCT FOREIGN KEY (PRODUCT_KEY) REFERENCES SNOWDBT_TUTO.MODEL_DATA.DIM_PRODUCT(PRODUCT_KEY),
	CONSTRAINT FK_FCT_SALES_DIM_ORDERSTATUS FOREIGN KEY (ORDER_STATUS_KEY) REFERENCES SNOWDBT_TUTO.MODEL_DATA.DIM_ORDERSTATUS(ORDER_STATUS_KEY),
	CONSTRAINT FK_FCT_SALES_DIM_ADDRESS FOREIGN KEY (SHIP_ADDRESS_KEY) REFERENCES SNOWDBT_TUTO.MODEL_DATA.DIM_ADDRESS(ADDRESS_KEY),
	CONSTRAINT FK_FCT_SALES_DIM_DATE FOREIGN KEY (ORDER_DATE_KEY) REFERENCES SNOWDBT_TUTO.MODEL_DATA.DIM_DATE(DATE_KEY),
	CONSTRAINT FK_FCT_SALES_DIM_TERRITORY FOREIGN KEY (TERRITORY_KEY) REFERENCES SNOWDBT_TUTO.MODEL_DATA.DIM_TERRITORY(TERRITORY_KEY)
);