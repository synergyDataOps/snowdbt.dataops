
-- SNOWDBT_TUTO.MODEL_DATA.DIM_ADDRESS definition

create or alter TABLE SNOWDBT_TUTO.MODEL_DATA.DIM_ADDRESS (
	ADDRESS_KEY VARCHAR(32),
	ADDRESSID NUMBER(5,0),
	CITY_NAME VARCHAR(16777216),
	POSTALCODE VARCHAR(16777216),
	ADDRESSLINE VARCHAR(16777216),
	STATE_NAME VARCHAR(50),
	COUNTRY_NAME VARCHAR(50),
	CONSTRAINT PK_DIM_ADDRESS PRIMARY KEY (ADDRESS_KEY)
);